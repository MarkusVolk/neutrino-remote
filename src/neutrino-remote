#!/usr/bin/env python3
"""neutrino-remote [--gtk | --qt] [--list-left | --list-right] [HOST] - remote control for a Neutrino box."""

import os
import shutil
import sys

SHARE = os.environ.get("NEUTRINO_REMOTE_SHARE") or os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "share", "neutrino-remote")
sys.path.insert(0, SHARE)
import remote  # noqa: E402


def frontends():
    found = {}
    gtk = os.path.join(SHARE, "neutrino-remote-gtk.py")
    if os.path.exists(gtk):
        found["gtk"] = [sys.executable, gtk]
    qt = shutil.which("neutrino-remote-qt")
    if qt:
        found["qt"] = [qt]
    return found


def main():
    args = sys.argv[1:]
    choice = os.environ.get("NEUTRINO_REMOTE_FRONTEND", "")
    for flag in ("--gtk", "--qt"):
        if flag in args:
            args.remove(flag)
            choice = flag[2:]
    side = remote.load_side()
    for flag in ("--list-left", "--list-right"):
        if flag in args:
            args.remove(flag)
            side = flag[7:]
            remote.save_side(side)
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if len(args) > 1 or (args and args[0].startswith("-")):
        print(__doc__.strip(), file=sys.stderr)
        return 2

    host = args[0].strip() if args else remote.load_host()
    remote.save_host(host)

    found = frontends()
    if not found:
        print("neutrino-remote: no frontend installed", file=sys.stderr)
        return 1
    if choice not in found:
        desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").upper()
        choice = "qt" if "qt" in found and ("KDE" in desktop or "gtk" not in found) else "gtk"

    command = found[choice] + [host, remote.config_file(), side]
    os.execv(command[0], command)


if __name__ == "__main__":
    sys.exit(main())
